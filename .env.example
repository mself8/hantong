# 이 파일을 .env로 복사해서 값을 채운다. .env는 레포에 올리지 않는다.
ANTHROPIC_API_KEY=
EXTRACT_MODEL=claude-opus-5-5
# Railway에서는 Postgres를 붙이면 자동으로 채워진다. 비우면 로컬 SQLite(hantong.db)를 쓴다.
DATABASE_URL=
# Vapi 서버 메시지에 붙일 비밀값. Vapi 어시스턴트 설정의 Server URL Secret과 같게 둔다.
VAPI_SECRET=
# 시연용 전화번호 -> 가상 어르신 ID. web은 번호 없는 웹 통화. 예: web:R006,01012345678:R001
DEMO_CALLERS=
# 발표장 QR 웹 통화(/call)용 Vapi 공개 키(Vapi > API Keys > Public Key). 어시스턴트를 바꿀 때만 VAPI_ASSISTANT_ID도 넣는다.
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
